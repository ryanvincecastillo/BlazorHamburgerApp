@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar @SidebarCssClasses"
         @onmouseenter="OnSidebarMouseEnter"
         @onmouseleave="OnSidebarMouseLeave">
        <NavMenu />
    </div>

    <main>
        <!-- Hamburger button toggles sidebar -->
        <button type="button" @onclick="ToggleSidebar" class="hamburger-toggle" aria-label="Toggle navigation">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>

        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool IsMinimized = false;
    private bool IsHoverExpanded = false;

    private string SidebarCssClasses =>
        $"sidebar{(IsMinimized ? " sidebar-minimized" : "")}{(IsHoverExpanded ? " sidebar-hover-expanded" : "")}";

    private void ToggleSidebar()
    {
        IsMinimized = !IsMinimized;
        IsHoverExpanded = false; 

        Console.WriteLine($"[Blazor] ToggleSidebar clicked. IsMinimized={IsMinimized}");
    }

    private void OnSidebarMouseEnter()
    {
        if (IsMinimized)
        {
            IsHoverExpanded = true;
        }
    }

    private void OnSidebarMouseLeave()
    {
        if (IsMinimized)
        {
            IsHoverExpanded = false;
        }
    }
}
